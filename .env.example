# Copy to .env to override defaults. Nothing here is billable: the default LLM is local Ollama.
BILLAUDITOR_DATA_DIR=data
BILLAUDITOR_RUNS_DIR=runs
BILLAUDITOR_TRACE_MAX_CHARS=4000

# LLM (used from Phase 4). Local only by default; no API key needed.
BILLAUDITOR_LLM_BASE_URL=http://localhost:11434/v1
BILLAUDITOR_LLM_MODEL=qwen2.5:7b-instruct
BILLAUDITOR_LLM_TEMPERATURE=0
